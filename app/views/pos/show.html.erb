<%= content_for :title, t("pos.title") %>

<div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[1fr_320px]">
  <div>
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-bold"><%= t("pos.title") %></h1>
      <%= link_to t("orders.title"), orders_path, class: "btn btn-secondary" %>
    </div>

    <% if current_user.cashier? || current_user.owner? %>
      <% if @open_shift %>
        <p class="mt-4 rounded-md border border-brand-200 bg-brand-50 px-3 py-2 text-sm text-brand-700 dark:border-brand-900 dark:bg-brand-950 dark:text-brand-300">
          <%= t("pos.shift_open", when: format_datetime(@open_shift.opened_at)) %>
        </p>
      <% else %>
        <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200">
          <%= t("pos.shift_closed_warning") %>
          <%= link_to t("pos.open_shift"), new_cash_register_path, class: "font-semibold underline" %>
        </p>
      <% end %>
    <% end %>

    <%= form_with url: pos_path, method: :get, class: "mt-4", role: "search" do |form| %>
      <div class="relative">
        <%= form.text_field :query, value: @query, id: "pos-search", autofocus: true, placeholder: t("pos.search_placeholder"), class: "input pr-10", autocomplete: "off", data: { shortcut: "/", shortcut_focus: "#pos-search" } %>
        <svg class="pointer-events-none absolute top-3 right-3 h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </div>
    <% end %>

    <div data-loading-target class="mt-6 space-y-8">
      <% if @menu.empty? %>
        <p class="text-sm text-slate-500 dark:text-slate-400"><%= t("pos.no_products") %></p>
      <% else %>
        <% @menu.each do |category, products| %>
          <section aria-label="<%= category.name %>">
            <h2 class="flex items-baseline gap-2">
              <span class="text-lg font-semibold"><%= category.name %></span>
              <span class="text-xs text-slate-400"><%= products.size %></span>
            </h2>

            <ul class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              <% products.each do |product| %>
                <li class="card flex min-h-[120px] flex-col justify-between gap-3 p-4">
                  <div>
                    <p class="font-medium"><%= product.name %></p>
                    <p class="mt-1 text-lg font-bold text-brand-600 dark:text-brand-400"><%= format_money(product.price) %></p>
                  </div>

                  <%= form_with url: cart_pos_path, class: "flex items-center gap-2", data: { turbo_frame: "_top" } do |form| %>
                    <%= hidden_field_tag :product_id, product.id %>
                    <%= number_field_tag :quantity, 1, min: 1, class: "input w-16", aria_label: t("pos.quantity_for", name: product.name) %>
                    <%= form.submit t("pos.add"), class: "btn btn-primary" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      <% end %>
    </div>
  </div>

  <aside class="lg:sticky lg:top-16 lg:self-start">
    <%= render "pos/cart", order: @draft_order %>
  </aside>
</div>
