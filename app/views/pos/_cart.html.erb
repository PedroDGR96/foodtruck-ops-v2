<div id="pos-cart" class="card p-4">
  <h2 class="text-lg font-semibold"><%= t("pos.cart") %></h2>

  <%= render "pos/customer", order: order %>

  <% if order.order_items.any? %>
    <ul class="mt-3 divide-y divide-slate-100 dark:divide-slate-800">
      <% order.order_items.each do |item| %>
        <li class="py-3">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-medium"><%= item.product_name %></p>
              <% if item.variant_name.present? %>
                <p class="text-xs text-slate-500 dark:text-slate-400"><%= item.variant_name %></p>
              <% end %>
              <% item.order_item_addons.each do |addon| %>
                <p class="text-xs text-slate-500 dark:text-slate-400">+ <%= addon.name %> (<%= format_money(addon.price) %>)</p>
              <% end %>
            </div>
            <p class="font-semibold"><%= format_money(item.line_total) %></p>
          </div>

          <div class="mt-2 flex items-center gap-2">
            <%= form_with url: cart_pos_path(item.id), method: :patch, class: "flex items-center gap-2" do |form| %>
              <%= number_field_tag :quantity, item.quantity, min: 1, class: "input w-16", aria_label: t("pos.quantity_for", name: item.product_name) %>
              <%= form.submit t("pos.update"), class: "btn btn-secondary" %>
            <% end %>
            <%= button_to t("pos.remove"), cart_pos_path(item.id), method: :delete, class: "btn btn-danger btn-sm" %>
          </div>
        </li>
      <% end %>
    </ul>

    <dl class="mt-4 space-y-1 border-t border-slate-100 pt-3 text-sm dark:border-slate-800">
      <div class="flex justify-between"><dt><%= t("orders.subtotal") %></dt><dd><%= format_money(order.subtotal) %></dd></div>
      <div class="flex justify-between"><dt><%= t("orders.tax") %></dt><dd><%= format_money(order.tax) %></dd></div>
      <% if order.delivery? %>
        <div class="flex justify-between"><dt><%= t("orders.delivery_fee") %></dt><dd><%= format_money(order.delivery_fee) %></dd></div>
      <% end %>
      <div class="flex justify-between font-semibold"><dt><%= t("orders.total") %></dt><dd><%= format_money(order.total) %></dd></div>
    </dl>

    <%= form_with url: confirm_pos_path, scope: :order, class: "mt-4", data: { controller: "delivery-form" } do |form| %>
      <div class="mb-3">
        <%= form.label :order_type, t("orders.order_type"), class: "label" %>
        <%= form.select :order_type, order_type_options, {}, class: "input", data: { delivery_form_target: "select", action: "delivery-form#toggle" } %>
      </div>
      <div data-delivery-form-target="addressFields" class="hidden space-y-3 border-t border-slate-100 pt-3 dark:border-slate-800">
        <div>
          <%= form.label :street, t("activerecord.attributes.delivery_address.street"), class: "label" %>
          <%= form.text_field :street, class: "input", name: "order[delivery_address][street]", data: { delivery_form_target: "street" } %>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= form.label :number, t("activerecord.attributes.delivery_address.number"), class: "label" %>
            <%= form.text_field :number, class: "input", name: "order[delivery_address][number]" %>
          </div>
          <div>
            <%= form.label :complement, t("activerecord.attributes.delivery_address.complement"), class: "label" %>
            <%= form.text_field :complement, class: "input", name: "order[delivery_address][complement]" %>
          </div>
        </div>
        <div>
          <%= form.label :neighborhood, t("activerecord.attributes.delivery_address.neighborhood"), class: "label" %>
          <%= form.text_field :neighborhood, class: "input", name: "order[delivery_address][neighborhood]" %>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= form.label :city, t("activerecord.attributes.delivery_address.city"), class: "label" %>
            <%= form.text_field :city, class: "input", name: "order[delivery_address][city]", data: { delivery_form_target: "city" } %>
          </div>
          <div>
            <%= form.label :state, t("activerecord.attributes.delivery_address.state"), class: "label" %>
            <%= form.text_field :state, class: "input", name: "order[delivery_address][state]", data: { delivery_form_target: "state" } %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= form.label :zip, t("activerecord.attributes.delivery_address.zip"), class: "label" %>
            <%= form.text_field :zip, class: "input", name: "order[delivery_address][zip]" %>
          </div>
          <div>
            <%= form.label :reference, t("activerecord.attributes.delivery_address.reference"), class: "label" %>
            <%= form.text_field :reference, class: "input", name: "order[delivery_address][reference]" %>
          </div>
        </div>
      </div>
      <%= form.submit t("pos.confirm"), class: "btn btn-primary w-full mt-4" %>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= t("pos.empty_cart") %></p>
  <% end %>
</div>
