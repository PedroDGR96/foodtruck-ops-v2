<%= form_with(model: category, class: "mt-6") do |f| %>
  <% if category.errors.any? %>
    <div class="mb-4 rounded-md bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, autofocus: true, class: "input" %>
  </div>

  <div class="mb-4">
    <%= f.label :position, class: "label" %>
    <%= f.number_field :position, class: "input" %>
  </div>

  <div class="mb-6">
    <%= f.label :active, class: "flex items-center gap-2 text-sm font-medium" %>
    <%= f.check_box :active, class: "rounded border-slate-300" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit category.new_record? ? t("categories.new.submit") : t("categories.edit.submit"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), categories_path, class: "btn btn-secondary" %>
  </div>
<% end %>
