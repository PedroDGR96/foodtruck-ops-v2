<%= form_with(model: product, class: "mt-6") do |f| %>
  <% if product.errors.any? %>
    <div class="mb-4 rounded-md bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, autofocus: true, class: "input" %>
  </div>

  <div class="mb-4">
    <%= f.label :category_id, class: "label" %>
    <%= f.collection_select :category_id, Current.business.categories.ordered, :id, :name, { include_blank: false }, class: "input" %>
  </div>

  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :price, class: "label" %>
      <%= f.number_field :price, step: "0.01", min: "0", class: "input" %>
    </div>
    <div>
      <%= f.label :status, class: "label" %>
      <%= f.select :status, Product.statuses.keys.map { |status| [t("products.status.#{status}"), status] }, {}, class: "input" %>
    </div>
  </div>

  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :position, class: "label" %>
      <%= f.number_field :position, class: "input" %>
    </div>
    <div>
      <%= f.label :image, class: "label" %>
      <%= f.file_field :image, accept: "image/*", class: "input" %>
    </div>
  </div>

  <div class="mb-6">
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description, rows: 3, class: "input" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit product.new_record? ? t("products.new.submit") : t("products.edit.submit"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), product.new_record? ? products_path : product_path(product), class: "btn btn-secondary" %>
  </div>
<% end %>
