<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold"><%= t("products.show.title", name: @product.name) %></h1>
  <div class="flex items-center gap-2">
    <%= link_to t("common.edit"), edit_product_path(@product), class: "btn btn-secondary" %>
    <%= button_to t("products.show.discard"), product_path(@product), method: :delete, class: "btn btn-danger", data: { turbo_confirm: t("products.show.discard_confirm") } %>
  </div>
</div>

<div class="mt-6 grid gap-6 md:grid-cols-3">
  <div class="card p-4 md:col-span-2">
    <dl class="grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.category") %></dt>
        <dd class="font-medium"><%= link_to @product.category.name, categories_path, class: "hover:underline" %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.price") %></dt>
        <dd class="font-medium"><%= format_money(@product.price) %></dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.status") %></dt>
        <dd>
          <% if @product.available? %>
            <span class="badge badge-success"><%= t("products.status.available") %></span>
          <% else %>
            <span class="badge badge-warning"><%= t("products.status.unavailable") %></span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.position") %></dt>
        <dd class="font-medium"><%= @product.position %></dd>
      </div>
      <% if @product.description.present? %>
        <div class="sm:col-span-2">
          <dt class="text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.description") %></dt>
          <dd class="mt-1"><%= @product.description %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="card p-4">
    <dt class="text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.image") %></dt>
    <% if @product.image.attached? %>
      <%= image_tag @product.image, class: "mt-2 h-40 w-full rounded-md object-cover" %>
    <% else %>
      <div class="mt-2 flex h-40 items-center justify-center rounded-md border border-dashed border-slate-300 text-sm text-slate-400 dark:border-slate-700">
        <%= t("products.show.no_image") %>
      </div>
    <% end %>
  </div>
</div>

<section class="mt-8">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold"><%= t("products.show.variants_title") %></h2>
    <%= link_to t("products.show.new_variant"), new_product_product_variant_path(@product), class: "btn btn-secondary" %>
  </div>

  <% if @product_variants.any? %>
    <ul class="mt-4 divide-y divide-slate-200 rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      <% @product_variants.each do |variant| %>
        <li class="flex items-center justify-between px-4 py-3">
          <div>
            <p class="font-medium"><%= variant.name %></p>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              <%= t("products.show.variant_price", price: format_money(variant.effective_price)) %>
              <% if variant.stock.present? %>
                · <%= t("products.show.variant_stock", stock: variant.stock) %>
              <% end %>
            </p>
          </div>
          <%= link_to t("common.edit"), edit_product_product_variant_path(@product, variant), class: "text-sm underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.no_variants") %></p>
  <% end %>
</section>

<section class="mt-8">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold"><%= t("products.show.addon_groups_title") %></h2>
    <%= link_to t("products.show.new_addon_group"), new_product_product_addon_group_path(@product), class: "btn btn-secondary" %>
  </div>

  <% if @product_addon_groups.any? %>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <% @product_addon_groups.each do |group| %>
        <div class="card p-4">
          <div class="flex items-center justify-between">
            <h3 class="font-semibold"><%= group.name %></h3>
            <div class="flex items-center gap-3">
              <span class="text-xs text-slate-500 dark:text-slate-400">
                <%= t("products.show.selection_range", min: group.min_select, max: group.max_select || "∞") %>
              </span>
              <%= link_to t("common.edit"), edit_product_product_addon_group_path(@product, group), class: "text-sm underline" %>
            </div>
          </div>
          <ul class="mt-3 divide-y divide-slate-100 dark:divide-slate-800">
            <% group.product_addons.ordered.each do |addon| %>
              <li class="flex items-center justify-between py-2 text-sm">
                <span><%= addon.name %></span>
                <span class="flex items-center gap-3">
                  <% if addon.price.positive? %>
                    <span class="text-slate-600 dark:text-slate-400"><%= format_money(addon.price) %></span>
                  <% else %>
                    <span class="text-slate-600 dark:text-slate-400"><%= t("common.included") %></span>
                  <% end %>
                  <%= link_to t("common.edit"), edit_product_product_addon_group_product_addon_path(@product, group, addon), class: "text-xs underline" %>
                </span>
              </li>
            <% end %>
          </ul>
          <%= link_to t("products.show.new_addon"), new_product_product_addon_group_product_addon_path(@product, group), class: "mt-3 inline-block text-sm font-medium underline" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400"><%= t("products.show.no_addon_groups") %></p>
  <% end %>
</section>
