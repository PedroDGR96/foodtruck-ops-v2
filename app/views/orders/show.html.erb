<%= content_for :title, t("orders.detail") %>

<div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[1fr_320px]">
  <div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold"><%= t("orders.detail") %> <%= order_display_number(@order) %></h1>
        <span class="badge <%= order_status_badge_class(@order.status) %>"><%= t("orders.statuses.#{@order.status}") %></span>
      </div>
      <%= link_to t("orders.back"), orders_path, class: "btn btn-secondary" %>
    </div>

    <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
      <div class="card p-3"><dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("orders.order_type") %></dt><dd class="font-medium"><%= t("orders.order_types.#{@order.order_type}") %></dd></div>
      <div class="card p-3"><dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("orders.payment_status") %></dt><dd class="font-medium"><%= t("orders.payment_statuses.#{@order.payment_status}") %></dd></div>
      <div class="card p-3"><dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("orders.created_at") %></dt><dd class="font-medium"><%= format_datetime(@order.created_at) %></dd></div>
      <div class="card p-3"><dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("orders.balance_due") %></dt><dd class="font-semibold"><%= format_money(@order.balance_due) %></dd></div>
    </dl>

    <% if @order.customer %>
      <div class="mt-4 card p-4">
        <dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("orders.customer") %></dt>
        <dd class="font-medium">
          <%= link_to @order.customer.name, customer_path(@order.customer), class: "hover:underline" %>
        </dd>
      </div>
    <% end %>

    <% if @order.delivery? %>
      <div class="mt-4 card p-4">
        <h2 class="text-sm font-semibold"><%= t("orders.delivery") %></h2>
        <% if @order.delivery_address %>
          <dl class="mt-2 space-y-1 text-sm">
            <div><dt class="inline text-xs text-slate-500 dark:text-slate-400"><%= t("activerecord.attributes.delivery_address.street") %>:</dt> <dd class="inline font-medium"><%= @order.delivery_address.street %><%= ", #{@order.delivery_address.number}" if @order.delivery_address.number.present? %></dd></div>
            <% if @order.delivery_address.complement.present? %>
              <div><dt class="inline text-xs text-slate-500 dark:text-slate-400"><%= t("activerecord.attributes.delivery_address.complement") %>:</dt> <dd class="inline font-medium"><%= @order.delivery_address.complement %></dd></div>
            <% end %>
            <div><dt class="inline text-xs text-slate-500 dark:text-slate-400"><%= t("activerecord.attributes.delivery_address.neighborhood") %>:</dt> <dd class="inline font-medium"><%= @order.delivery_address.neighborhood %></dd></div>
            <div><dt class="inline text-xs text-slate-500 dark:text-slate-400"><%= t("activerecord.attributes.delivery_address.city") %>:</dt> <dd class="inline font-medium"><%= @order.delivery_address.city %>/<%= @order.delivery_address.state %></dd></div>
            <% if @order.delivery_address.reference.present? %>
              <div><dt class="inline text-xs text-slate-500 dark:text-slate-400"><%= t("activerecord.attributes.delivery_address.reference") %>:</dt> <dd class="inline font-medium"><%= @order.delivery_address.reference %></dd></div>
            <% end %>
          </dl>
        <% end %>
        <% if @order.delivery %>
          <div class="mt-2 text-sm">
            <span class="badge <%= order_status_badge_class(@order.delivery.status) %>"><%= t("orders.delivery_statuses.#{@order.delivery.status}") %></span>
          </div>
          <div class="mt-3 space-y-2">
            <% if @order.delivery.status == "pending" && policy(@order).mark_out_for_delivery? %>
              <%= button_to t("orders.mark_out_for_delivery"), out_for_delivery_order_path(@order), method: :post, class: "btn btn-secondary w-full" %>
            <% end %>
            <% if @order.delivery.status == "out_for_delivery" && policy(@order).mark_delivered? %>
              <%= button_to t("orders.mark_delivered"), delivered_order_path(@order), method: :post, class: "btn btn-success w-full" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "orders/ticket", order: @order %>

    <div class="mt-6 card p-4">
      <h2 class="text-lg font-semibold"><%= t("orders.payments") %></h2>
      <% if @order.payments.any? %>
        <ul class="mt-3 space-y-2 text-sm">
          <% @order.payments.order(created_at: :desc).each do |payment| %>
            <li class="flex items-center justify-between border-b border-slate-100 pb-2 last:border-0 dark:border-slate-800">
              <span><%= payment_method_label(payment.method) %> · <%= t("orders.payment_statuses.#{payment.status}") %></span>
              <span class="font-semibold"><%= format_money(payment.amount) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= t("orders.no_payments") %></p>
      <% end %>
    </div>

    <div class="mt-6 card p-4">
      <h2 class="text-lg font-semibold"><%= t("orders.events") %></h2>
      <% if @order_events.any? %>
        <ul class="mt-3 space-y-2 text-sm">
          <% @order_events.each do |event| %>
            <li class="flex items-center justify-between border-b border-slate-100 pb-2 last:border-0 dark:border-slate-800">
              <span><%= t("orders.events_list.#{event.event}") %></span>
              <span class="text-xs text-slate-500 dark:text-slate-400"><%= format_datetime(event.created_at) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= t("orders.no_events") %></p>
      <% end %>
    </div>
  </div>

  <aside class="lg:sticky lg:top-16 lg:self-start">
    <div class="card space-y-3 p-4">
      <h2 class="text-lg font-semibold"><%= t("orders.actions") %></h2>
      <% if @order.pending_payment? && policy(@order).pay? %>
        <%= link_to t("orders.collect_payment"), checkout_path(@order), class: "btn btn-primary w-full" %>
      <% end %>
      <% if policy(@order).cancel? %>
        <%= button_to t("orders.cancel_order"), cancel_order_path(@order), method: :post, class: "btn btn-secondary w-full" %>
      <% end %>
      <% if policy(@order).refund? && @order.paid? %>
        <%= button_to t("orders.refund"), refund_order_path(@order), method: :post, class: "btn btn-danger w-full", data: { confirm: t("orders.refund_confirm") } %>
      <% end %>
    </div>
  </aside>
</div>
