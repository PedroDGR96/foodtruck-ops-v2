<div id="order-<%= order.id %>" class="card mt-6 p-4">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold"><%= t("orders.ticket") %> <%= order_display_number(order) %></h2>
    <div class="flex items-center gap-2">
      <span class="badge <%= order_status_badge_class(order.kitchen_status) %>"><%= t("orders.kitchen_statuses.#{order.kitchen_status}") %></span>
      <button type="button" onclick="window.print()" class="btn btn-secondary btn-sm" aria-label="<%= t("orders.print_ticket") %>">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z"/></svg>
      </button>
    </div>
  </div>

  <ul class="mt-3 divide-y divide-slate-100 text-sm dark:divide-slate-800">
    <% order.order_items.each do |item| %>
      <li class="py-3">
        <div class="flex items-start justify-between gap-2">
          <div>
            <p class="font-medium"><span class="text-slate-400">×<%= item.quantity %></span> <%= item.product_name %></p>
            <% if item.variant_name.present? %>
              <p class="text-xs text-slate-500 dark:text-slate-400"><%= item.variant_name %></p>
            <% end %>
          </div>
          <p class="font-semibold"><%= format_money(item.line_total) %></p>
        </div>
        <% item.order_item_addons.each do |addon| %>
          <p class="mt-1 pl-4 text-xs text-slate-500 dark:text-slate-400">+ <%= addon.name %> (<%= format_money(addon.price) %>)</p>
        <% end %>
      </li>
    <% end %>
  </ul>

  <dl class="mt-2 space-y-1 border-t border-slate-100 pt-3 text-sm dark:border-slate-800">
    <div class="flex justify-between"><dt><%= t("orders.subtotal") %></dt><dd><%= format_money(order.subtotal) %></dd></div>
    <div class="flex justify-between"><dt><%= t("orders.tax") %></dt><dd><%= format_money(order.tax) %></dd></div>
    <% if order.delivery? %>
      <div class="flex justify-between"><dt><%= t("orders.delivery_fee") %></dt><dd><%= format_money(order.delivery_fee) %></dd></div>
    <% end %>
    <div class="flex justify-between font-semibold"><dt><%= t("orders.total") %></dt><dd><%= format_money(order.total) %></dd></div>
  </dl>

  <% if order.notes.present? %>
    <p class="mt-3 rounded-md bg-slate-50 p-2 text-sm text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= order.notes %></p>
  <% end %>
</div>
