<%= form_with(model: [ product, product_addon_group ], class: "mt-6") do |f| %>
  <% if product_addon_group.errors.any? %>
    <div class="mb-4 rounded-md bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
      <ul>
        <% product_addon_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, autofocus: true, class: "input" %>
  </div>

  <div class="mb-4">
    <%= f.label :multiple, t("product_addon_groups.form.multiple_hint"), class: "flex items-center gap-2 text-sm font-medium" %>
    <%= f.check_box :multiple, class: "rounded border-slate-300" %>
  </div>

  <div class="mb-4 grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :min_select, class: "label" %>
      <%= f.number_field :min_select, min: "0", class: "input" %>
    </div>
    <div>
      <%= f.label :max_select, t("product_addon_groups.form.max_select_hint"), class: "label" %>
      <%= f.number_field :max_select, min: "0", placeholder: t("product_addon_groups.form.max_select_placeholder"), class: "input" %>
    </div>
  </div>

  <div class="mb-4">
    <%= f.label :position, class: "label" %>
    <%= f.number_field :position, class: "input" %>
  </div>

  <div class="mb-6">
    <%= f.label :active, class: "flex items-center gap-2 text-sm font-medium" %>
    <%= f.check_box :active, class: "rounded border-slate-300" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit product_addon_group.new_record? ? t("product_addon_groups.new.submit") : t("product_addon_groups.edit.submit"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), product_path(product), class: "btn btn-secondary" %>
  </div>
<% end %>
