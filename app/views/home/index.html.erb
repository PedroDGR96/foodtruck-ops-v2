<h1 class="text-3xl font-bold"><%= t("home.title", name: current_user.name) %></h1>

<p class="mt-4 text-slate-600">
  <%= t("home.signed_in_as", role: t("roles.#{current_user.role}"), business: Current.business.name) %>
</p>

<nav class="mt-8 flex gap-4">
  <% if current_user.owner? %>
    <%= link_to t("home.manage_staff"), users_path, class: "btn btn-primary" %>
    <%= link_to t("home.business_settings"), edit_settings_path, class: "btn btn-secondary" %>
  <% else %>
    <div class="mt-8 w-full">
      <%= render "layouts/empty_state", title: t("home.empty_title", role: t("roles.#{current_user.role}")), message: t("home.placeholder") %>
    </div>
  <% end %>
</nav>
