<%# Empty state for lists/features without content yet.
    Usage: <%= render "layouts/empty_state", title: t("..."), message: t("...") %> %>
<div class="flex flex-col items-center justify-center rounded-lg border border-dashed border-slate-300 px-6 py-16 text-center dark:border-slate-700">
  <h2 class="text-lg font-semibold text-slate-700 dark:text-slate-200"><%= title %></h2>
  <% if local_assigns[:message] %>
    <p class="mt-2 max-w-sm text-sm text-slate-500 dark:text-slate-400"><%= message %></p>
  <% end %>
  <% if local_assigns[:action] %>
    <div class="mt-4"><%= action %></div>
  <% end %>
</div>
