    <div class="flex items-center justify-around py-2">
      <%= link_to t("layouts.nav.menu"), menu_path, class: "btn btn-ghost" %>
      <%= link_to t("home.title_short"), root_path, class: "btn btn-ghost" %>
      <span class="btn btn-ghost"><%= t("roles.#{current_user.role}") %></span>
    </div>
  </nav>
<% end %>
