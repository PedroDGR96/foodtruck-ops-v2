<% if current_user.owner? %>
  <%= link_to t("home.title_short"), root_path, class: nav_link_class(request.path == root_path) %>
  <%= link_to t("layouts.nav.pos"), pos_path, class: nav_link_class(request.path == pos_path) %>
  <%= link_to t("layouts.nav.cash_register"), cash_registers_path, class: nav_link_class(request.path.start_with?(cash_registers_path)) %>
