<% if current_user.owner? %>
  <%= link_to t("home.title_short"), root_path, class: nav_link_class(request.path == root_path) %>
  <%= link_to t("layouts.nav.menu"), categories_path, class: nav_link_class(request.path.start_with?(categories_path)) %>
  <%= link_to t("layouts.nav.staff"), users_path, class: nav_link_class(request.path.start_with?(users_path)) %>
  <%= link_to t("layouts.nav.settings"), edit_settings_path, class: nav_link_class(request.path.start_with?(settings_path)) %>
<% else %>
  <%= link_to t("layouts.nav.menu"), menu_path, class: nav_link_class(request.path == menu_path) %>
  <%= link_to t("home.title_short"), root_path, class: nav_link_class(request.path == root_path) %>
<% end %>
