<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-bold"><%= t("settings.edit.title") %></h1>

  <%= form_with(model: @business, url: settings_path, class: "mt-6 space-y-4") do |f| %>
    <% if @business.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
        <ul class="list-disc pl-4">
          <% @business.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, class: "input" %>
    </div>

    <div>
      <%= f.label :timezone, class: "label" %>
      <%= f.time_zone_select :timezone, nil, {}, class: "input" %>
    </div>

    <div>
      <%= f.label :currency, class: "label" %>
      <%= f.text_field :currency, class: "input" %>
    </div>

    <div>
      <%= f.label :delivery_fee, class: "label" %>
      <%= f.number_field :delivery_fee, step: "0.01", min: 0, value: @business.delivery_fee, class: "input" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :active, class: "rounded border-slate-300 dark:border-slate-600 dark:bg-slate-800" %>
      <%= f.label :active, class: "text-sm font-medium dark:text-slate-300" %>
    </div>

    <%= f.submit t("settings.edit.submit"), class: "btn btn-primary w-full" %>
  <% end %>
</div>
