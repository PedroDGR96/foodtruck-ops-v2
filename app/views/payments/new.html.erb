<%= content_for :title, t("orders.collect_payment") %>

<div class="mx-auto max-w-md">
  <%= link_to t("orders.back_to"), order_path(@order), class: "text-sm text-brand-600 hover:underline dark:text-brand-400" %>

  <div class="mt-4 card p-6">
    <h1 class="text-xl font-bold"><%= t("orders.collect_payment") %></h1>

    <dl class="mt-4 space-y-1 text-sm">
      <div class="flex justify-between"><dt><%= t("orders.total") %></dt><dd class="font-semibold"><%= format_money(@order.total) %></dd></div>
      <div class="flex justify-between"><dt><%= t("orders.already_paid") %></dt><dd><%= format_money(@order.paid_amount) %></dd></div>
      <div class="flex justify-between font-semibold"><dt><%= t("orders.balance_due") %></dt><dd class="text-brand-600 dark:text-brand-400"><%= format_money(@order.balance_due) %></dd></div>
    </dl>

    <%= form_with model: [ @order, @payment ], class: "mt-6 space-y-4" do |form| %>
      <% if @payment.errors.any? %>
        <div class="rounded-md bg-red-50 p-3 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
          <% @payment.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= form.label :method, t("orders.method"), class: "label" %>
        <%= form.select :method, Payment.methods.keys.map { |key| [ payment_method_label(key), key ] }, {}, class: "input" %>
      </div>

      <div>
        <%= form.label :amount, t("orders.amount"), class: "label" %>
        <%= form.number_field :amount, step: "0.01", min: "0.01", max: @order.balance_due, value: @order.balance_due, class: "input", autofocus: true %>
      </div>

      <div>
        <%= form.label :gateway_reference, t("orders.gateway_reference"), class: "label" %>
        <%= form.text_field :gateway_reference, class: "input", placeholder: t("orders.gateway_reference_hint") %>
      </div>

      <%= form.submit t("orders.pay"), class: "btn btn-primary w-full" %>
    <% end %>
  </div>
</div>
