<%= content_for :title, t("kitchen.title") %>

<div class="mx-auto max-w-6xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold"><%= t("kitchen.title") %></h1>
  </div>

  <% @orders.group_by(&:order_type).sort_by { |type, _| %w[local delivery pickup].index(type) || 99 }.each do |type, orders| %>
    <section class="mt-6">
      <h2 class="text-lg font-semibold"><%= t("orders.order_types.#{type}") %></h2>
      <div class="mt-3 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% orders.each do |order| %>
          <%= render "ticket", order: order %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @orders.empty? %>
    <p class="mt-6 card p-4 text-sm text-slate-500 dark:text-slate-400"><%= t("kitchen.empty") %></p>
  <% end %>
</div>
