<div class="mx-auto max-w-md">
  <h1 class="text-2xl font-bold"><%= t("users.new.title") %></h1>

  <%= form_with(model: @user, class: "mt-6") do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-4 rounded-md bg-red-50 p-4 text-sm text-red-700">
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, class: "block text-sm font-medium" %>
      <%= f.text_field :name, autofocus: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium" %>
      <%= f.email_field :email, autocomplete: "off", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :role, class: "block text-sm font-medium" %>
      <%= f.select :role, User.roles.keys.map { |role| [t("roles.#{role}").capitalize, role] }, {}, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block text-sm font-medium" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
    </div>

    <div class="mb-6">
      <%= f.label :password_confirmation, class: "block text-sm font-medium" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
    </div>

    <%= f.submit t("users.new.submit"), class: "btn btn-primary w-full" %>
  <% end %>
</div>
