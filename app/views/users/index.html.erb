<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold"><%= t("users.index.title") %></h1>
    <%= link_to t("users.index.add"), new_user_path, class: "btn btn-primary" %>
  </div>

  <ul class="mt-6 divide-y divide-slate-200 border-t border-slate-200">
    <% @users.each do |user| %>
      <li class="flex items-center justify-between py-3">
        <div>
          <p class="font-medium"><%= user.name %></p>
          <p class="text-sm text-slate-500"><%= user.email %></p>
        </div>
        <div class="flex items-center gap-3">
          <% unless user.active? %>
            <span class="rounded bg-red-50 px-2 py-1 text-xs text-red-700"><%= t("common.inactive") %></span>
          <% end %>
          <span class="rounded bg-slate-100 px-2 py-1 text-xs capitalize"><%= t("roles.#{user.role}") %></span>
          <%= link_to t("common.edit"), edit_user_path(user), class: "text-sm text-slate-600 underline" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
