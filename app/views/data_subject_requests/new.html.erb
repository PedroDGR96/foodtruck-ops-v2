<h1 class="text-3xl font-bold"><%= t("compliance.dsar.new_request") %></h1>

<div class="mt-6 max-w-xl rounded-xl bg-white p-6 shadow dark:bg-slate-800">
  <%= form_with model: @dsar || DataSubjectRequest.new, url: data_subject_requests_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :data_subject_email, t("compliance.dsar.email"), class: "block text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <%= f.email_field :data_subject_email, class: "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900", required: true %>
    </div>

    <div>
      <%= f.label :request_type, t("compliance.dsar.type"), class: "block text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <%= f.select :request_type,
          DataSubjectRequest::REQUEST_TYPES.map { |t| [I18n.t("compliance.dsar.types.#{t}"), t] },
          { include_blank: t("common.select") },
          class: "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900",
          required: true %>
    </div>

    <div>
      <%= f.label :description, t("compliance.dsar.description"), class: "block text-sm font-medium text-slate-700 dark:text-slate-200" %>
      <%= f.text_area :description, rows: 4, class: "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900" %>
    </div>

    <div>
      <%= f.submit t("compliance.dsar.submit"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
