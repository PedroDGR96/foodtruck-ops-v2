<%= form_with(model: customer, class: "mt-6") do |f| %>
  <% if customer.errors.any? %>
    <div class="mb-4 rounded-md bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
      <ul>
        <% customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, autofocus: true, class: "input" %>
  </div>

  <div class="mb-4">
    <%= f.label :phone, class: "label" %>
    <%= f.telephone_field :phone, class: "input", placeholder: t("customers.form.phone_placeholder") %>
  </div>

  <div class="mb-4">
    <%= f.label :whatsapp, class: "label" %>
    <%= f.telephone_field :whatsapp, class: "input" %>
  </div>

  <div class="mb-4">
    <%= f.label :birthday, class: "label" %>
    <%= f.date_field :birthday, class: "input" %>
  </div>

  <div class="mb-6">
    <%= f.label :notes, class: "label" %>
    <%= f.text_area :notes, rows: 3, class: "input" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit customer.new_record? ? t("customers.new.submit") : t("customers.edit.submit"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), customer.new_record? ? customers_path : customer_path(customer), class: "btn btn-secondary" %>
  </div>
<% end %>
