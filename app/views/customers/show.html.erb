<%= content_for :title, @customer.name %>

<div class="flex items-center justify-between">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-bold"><%= @customer.name %></h1>
    <%= link_to t("pos.title"), pos_path, class: "btn btn-primary btn-sm" %>
    <%= link_to t("customers.show.edit"), edit_customer_path(@customer), class: "btn btn-secondary btn-sm" if policy(@customer).update? %>
  </div>
  <%= link_to t("customers.show.back"), customers_path, class: "btn btn-secondary" %>
</div>

<div class="mt-4 card p-4">
  <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-xs text-slate-500 dark:text-slate-400"><%= Customer.human_attribute_name(:phone) %></dt>
      <dd class="font-medium"><%= @customer.phone.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs text-slate-500 dark:text-slate-400"><%= Customer.human_attribute_name(:whatsapp) %></dt>
      <dd class="font-medium"><%= @customer.whatsapp.presence || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs text-slate-500 dark:text-slate-400"><%= Customer.human_attribute_name(:birthday) %></dt>
      <dd class="font-medium"><%= format_date(@customer.birthday) || "—" %></dd>
    </div>
    <div>
      <dt class="text-xs text-slate-500 dark:text-slate-400"><%= Customer.human_attribute_name(:notes) %></dt>
      <dd class="font-medium"><%= @customer.notes.presence || "—" %></dd>
    </div>
  </dl>
</div>

<div class="mt-6 grid grid-cols-3 gap-3">
  <div class="card p-4">
    <dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("customers.show.orders_count") %></dt>
    <dd class="mt-1 text-2xl font-bold"><%= @history.order_count %></dd>
  </div>
  <div class="card p-4">
    <dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("customers.show.total_spent") %></dt>
    <dd class="mt-1 text-2xl font-bold"><%= format_money(@history.total_spent) %></dd>
  </div>
  <div class="card p-4">
    <dt class="text-xs text-slate-500 dark:text-slate-400"><%= t("customers.show.average_spend") %></dt>
    <dd class="mt-1 text-2xl font-bold"><%= format_money(@history.average_spend) %></dd>
  </div>
</div>

<div class="mt-6 card p-4">
  <h2 class="text-lg font-semibold"><%= t("customers.show.history") %></h2>
  <% if @history.orders.any? %>
    <ul class="mt-3 space-y-2 text-sm">
      <% @history.orders.each do |order| %>
        <li class="flex items-center justify-between gap-3 border-b border-slate-100 pb-2 last:border-0 dark:border-slate-800">
          <div class="min-w-0">
            <%= link_to "#{t("customers.show.order")} ##{order.id}", order_path(order), class: "font-medium hover:underline" %>
            <p class="text-xs text-slate-500 dark:text-slate-400"><%= format_datetime(order.created_at) %></p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <span class="badge <%= order_status_badge_class(order.status) %>"><%= t("orders.statuses.#{order.status}") %></span>
            <span class="font-semibold"><%= format_money(order.total) %></span>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= t("customers.show.no_history") %></p>
  <% end %>
</div>
