<%= content_for :title, t("cash_registers.title") %>

<div class="mx-auto max-w-5xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold"><%= t("cash_registers.title") %></h1>
    <% if policy(CashRegister).create? && @current_shift.nil? %>
      <%= link_to t("cash_registers.open_shift"), new_cash_register_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <section aria-label="<%= t("cash_registers.current_shift") %>" class="mt-6 card p-4">
    <% if @current_shift %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold"><%= t("cash_registers.current_shift") %></h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            <%= t("cash_registers.opened_at", when: format_datetime(@current_shift.opened_at)) %>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <span class="badge badge-success"><%= t("cash_registers.statuses.open") %></span>
          <%= link_to t("cash_registers.view_shift"), @current_shift, class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 dark:text-slate-400"><%= t("cash_registers.no_open_shift") %></p>
    <% end %>
  </section>

  <section aria-label="<%= t("cash_registers.history") %>" class="mt-6">
    <h2 class="text-lg font-semibold"><%= t("cash_registers.history") %></h2>
    <div class="mt-3 card overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 text-left text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
            <th class="px-4 py-3 font-medium"><%= t("cash_registers.opened_at_short") %></th>
            <th class="px-4 py-3 font-medium"><%= t("cash_registers.cashier") %></th>
            <th class="px-4 py-3 font-medium"><%= t("cash_registers.status") %></th>
            <th class="px-4 py-3 text-right font-medium"><%= t("cash_registers.expected") %></th>
            <th class="px-4 py-3 text-right font-medium"><%= t("cash_registers.actual") %></th>
            <th class="px-4 py-3 text-right font-medium"><%= t("cash_registers.drift") %></th>
          </tr>
        </thead>
        <tbody>
          <% @registers.each do |register| %>
            <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3"><%= link_to format_datetime(register.opened_at), register, class: "font-medium text-brand-600 hover:underline dark:text-brand-400" %></td>
              <td class="px-4 py-3"><%= register.user.name %></td>
              <td class="px-4 py-3">
                <% if register.open? %>
                  <span class="badge badge-info"><%= t("cash_registers.statuses.open") %></span>
                <% elsif register.reconciled %>
                  <span class="badge badge-success"><%= t("cash_registers.statuses.closed") %></span>
                <% else %>
                  <span class="badge badge-warning"><%= t("cash_registers.statuses.drifted") %></span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right"><%= register.expected_closing_amount ? format_money(register.expected_closing_amount) : "—" %></td>
              <td class="px-4 py-3 text-right"><%= register.actual_closing_amount ? format_money(register.actual_closing_amount) : "—" %></td>
              <td class="px-4 py-3 text-right">
                <% if register.drift && !register.drift.zero? %>
                  <span class="font-semibold text-red-600 dark:text-red-400"><%= format_money(register.drift) %></span>
                <% else %>
                  <span class="text-slate-400">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @registers.empty? %>
        <p class="p-4 text-sm text-slate-500 dark:text-slate-400"><%= t("cash_registers.no_shifts") %></p>
      <% end %>
    </div>
  </section>
</div>
